#!/bin/sh
set -eu
SOLO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
export SOLO_ROOT
export UV_PROJECT_ENVIRONMENT="$SOLO_ROOT/.venv"
export UV_CACHE_DIR="$SOLO_ROOT/.uv-cache"
export UV_PYTHON_INSTALL_DIR="$SOLO_ROOT/.uv-python"
export UV_PYTHON_BIN_DIR="$SOLO_ROOT/.local/bin"
export UV_PYTHON_PREFERENCE=only-managed
export UV_TOOL_DIR="$SOLO_ROOT/.local/uv-tools"
export UV_TOOL_BIN_DIR="$SOLO_ROOT/.local/bin"
export XDG_CACHE_HOME="$SOLO_ROOT/.cache"
export XDG_CONFIG_HOME="$SOLO_ROOT/.config"
export XDG_DATA_HOME="$SOLO_ROOT/.local/share"
export XDG_STATE_HOME="$SOLO_ROOT/.local/state"
export XDG_BIN_HOME="$SOLO_ROOT/.local/bin"
export TORCH_HOME="$SOLO_ROOT/.cache/torch"
export HF_HOME="$SOLO_ROOT/.cache/huggingface"
export HUGGINGFACE_HUB_CACHE="$HF_HOME/hub"
export HF_HUB_DISABLE_TELEMETRY=1
export HF_HUB_DISABLE_XET=1
export ULTRALYTICS_CONFIG_DIR="$SOLO_ROOT/.config/ultralytics"
export YOLO_CONFIG_DIR="$ULTRALYTICS_CONFIG_DIR"
export YOLO_AUTOINSTALL=false
export YOLO_OFFLINE=true
export MPLCONFIGDIR="$SOLO_ROOT/.config/matplotlib"
export PYTHONPYCACHEPREFIX="$SOLO_ROOT/.cache/pycache"
export CUDA_CACHE_PATH="$SOLO_ROOT/.cache/nvidia/ComputeCache"
export TORCHINDUCTOR_CACHE_DIR="$SOLO_ROOT/.cache/torchinductor"
export TRITON_CACHE_DIR="$SOLO_ROOT/.cache/triton"
export TMPDIR="$SOLO_ROOT/work/tmp"
export TMP="$TMPDIR"
export TEMP="$TMPDIR"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-1}"
export VECLIB_MAXIMUM_THREADS="${VECLIB_MAXIMUM_THREADS:-1}"
export PYTHONNOUSERSITE=1
export CUBLAS_WORKSPACE_CONFIG=:4096:8
unset VIRTUAL_ENV CONDA_PREFIX PYTHONHOME PYTHONPATH UV_PROJECT UV_PYTHON
mkdir -p "$TMPDIR" "$CUDA_CACHE_PATH" "$ULTRALYTICS_CONFIG_DIR/Ultralytics"
if ! command -v uv >/dev/null 2>&1; then
  echo "SOLO requires a pre-existing uv executable." >&2
  exit 1
fi
case "${1:-}" in
  compare-backbones) exec uv run --directory "$SOLO_ROOT" --frozen --group comparison -- python -m solo "$@" ;;
  test) shift; exec uv run --directory "$SOLO_ROOT" --frozen --group dev -- python -m pytest "$@" ;;
  check) shift; exec uv run --directory "$SOLO_ROOT" --frozen --group dev -- ruff check "$@" ;;
  *) exec uv run --directory "$SOLO_ROOT" --frozen -- python -m solo "$@" ;;
esac
